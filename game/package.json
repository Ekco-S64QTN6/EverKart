{
  "name": "everkart",
  "productName": "EverKart",
  "version": "0.2.0",
  "description": "A kart racer through real EverQuest zones, built from your own EverQuest files",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "app:dev": "EVERKART_DEV=1 electron .",
    "dist": "vite build && electron-builder --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^23.10.4",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.21.5": true
  }
}
